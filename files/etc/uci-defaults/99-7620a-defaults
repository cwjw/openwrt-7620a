#!/bin/sh
# 首次启动执行一次：系统标识、时区、LAN 地址、基础服务
# 由 /etc/init.d/boot 在开机时执行，执行后自动删除

# 标记：本 overlay 是本固件自己创建的（供 lib/preinit/82_7620a_overlay_guard 判断，
# 避免把原厂 SeaOS 留下的 jffs2 当配置继续用）
touch /etc/.7620a_applied

uci -q set system.@system[0].hostname='7620A-Router' || true
uci -q set system.@system[0].timezone='CST-8' || true
uci -q set system.@system[0].zonename='Asia/Shanghai' || true
uci -q set system.@system[0].conceal_ssid='0' || true
uci -q set system.@system[0].conceal_bssid='0' || true

# NTP 国内可用源
uci -q set system.ntp.enabled='1' || true
uci -q set system.ntp.enable_server='0' || true

# LAN：默认 192.168.10.1/24，避开光猫常用的 192.168.1.1
uci -q set network.lan.proto='static' || true
uci -q set network.lan.ipaddr='192.168.10.1' || true
uci -q set network.lan.netmask='255.255.255.0' || true
uci -q set network.lan.ip6assign='60' || true

# 网口兜底：/etc/board.d/02_network_sl-ir4 正常生效时这里什么都不做；
# 万一 switch/VLAN 没生成（例如升级后 board.json 已存在），就地补一份，
# 保证 port0=LAN(eth0.1)、port4=WAN(eth0.2) 一定存在，不会出现“刷完没网口”。
if ! uci -q show network | grep -q 'network.@switch_vlan'; then
	uci -q add network switch >/dev/null || true
	uci -q set network.@switch[-1].name='switch0' || true
	uci -q set network.@switch[-1].reset='1' || true
	uci -q set network.@switch[-1].enable_vlan='1' || true

	v1=$(uci -q add network switch_vlan) || true
	uci -q set network.$v1.device='switch0' || true
	uci -q set network.$v1.vlan='1' || true
	uci -q set network.$v1.ports='0 1 2 3 6t' || true

	v2=$(uci -q add network switch_vlan) || true
	uci -q set network.$v2.device='switch0' || true
	uci -q set network.$v2.vlan='2' || true
	uci -q set network.$v2.ports='4 6t' || true
fi

[ -z "$(uci -q get network.lan.device)" ]  && uci -q set network.lan.device='eth0.1' || true
[ -z "$(uci -q get network.wan.device)" ]  && uci -q set network.wan.device='eth0.2' || true
[ -z "$(uci -q get network.wan.proto)" ]   && uci -q set network.wan.proto='dhcp' || true

# DHCP：地址池与网关同网段
uci -q set dhcp.lan.start='100' || true
uci -q set dhcp.lan.limit='150' || true
uci -q set dhcp.lan.leasetime='12h' || true

# ------------------------------------------------------------------
# 指示灯：DTS 里 link 灯只写了 linux,default-trigger="netdev"，
# 而 netdev 触发器不指定监视设备时永远不会亮 → 必须在 system 里补 dev。
# 面板自左至右：上排 WIFI / 4G，下排 SYS / LINK。
# ------------------------------------------------------------------
if ! uci -q get system.led_7620a_link >/dev/null 2>&1; then
	r=$(uci -q add system led) || true
	uci -q set system.$r.name='link' || true
	uci -q set system.$r.sysfs='link' || true
	uci -q set system.$r.trigger='netdev' || true
	uci -q set system.$r.dev='br-lan' || true
	uci -q set system.$r.mode='link tx rx' || true
	uci -q set system.$r.default='0' || true
fi

# 关闭可能干扰的默认服务
uci -q set uhttpd.main.redirect_https='0' || true

uci -q commit system || true
uci -q commit network || true
uci -q commit dhcp || true
uci -q commit uhttpd || true

exit 0

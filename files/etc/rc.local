#!/bin/sh
#
# 【仪表版】只往 /tmp（tmpfs/内存）写，绝不碰 flash。
#   - 旧版每秒写 /root/diag 再 sync，等于每秒一次 jffs2 擦写，本身就是一个
#     与原厂差异极大的变量（原厂从不这么干），本版彻底去掉。
#   - 每 5 秒采样 SoC 定时器/复位寄存器，写到 /tmp/regs.txt。
#     复位后 /tmp 清空，所以必须在 150~174 秒那个 SSH 窗口里 cat /tmp/regs.txt。
#
# 判读方法：
#   t1l（TMR1LOAD，0x10000120）如果在死前一路递减  → SoC 里真有倒计时器在跑
#   t1l 恒定不动                                     → 复位来自定时器以外
#   t1c 的 bit7=1 表示 TMR1 已使能；bit0-1=3 表示处于 WDT 模式
#   rst（RSTSTAT，0x10000038）bit1=WDT_RST_CAUSE，跨复位保留

D=/tmp
REG_RST=0x10000038
REG_TSTAT=0x10000100
REG_T0L=0x10000110
REG_T0C=0x10000118
REG_T1L=0x10000120
REG_T1C=0x10000128

if command -v devmem >/dev/null 2>&1; then DV=yes; else DV=NO; fi
reg() { devmem "$1" 32 2>/dev/null; }

{
	echo "=== boot $(date 2>/dev/null) up=$(cut -d' ' -f1 /proc/uptime)"
	echo "--- devmem=$DV"
	echo "--- RSTSTAT=$(reg $REG_RST) TMRSTAT=$(reg $REG_TSTAT)"
	echo "--- TMR0LOAD=$(reg $REG_T0L) TMR0CTL=$(reg $REG_T0C)"
	echo "--- TMR1LOAD=$(reg $REG_T1L) TMR1CTL=$(reg $REG_T1C)"
	dmesg 2>/dev/null | grep -iE "Linux version|Memory:|rt2880_wdt|watchdog|Reset" | head -10
} > $D/boot.txt 2>&1

(
	n=0
	while :; do
		U=$(cut -d' ' -f1 /proc/uptime)
		echo "up=$U load=$(cut -d' ' -f1-3 /proc/loadavg) rst=$(reg $REG_RST) tstat=$(reg $REG_TSTAT) t0l=$(reg $REG_T0L) t0c=$(reg $REG_T0C) t1l=$(reg $REG_T1L) t1c=$(reg $REG_T1C)" >> $D/regs.txt
		n=$((n + 1))
		# 前 200 秒每 5 秒一次，之后每 30 秒一次，防止无限增长
		if [ $n -lt 40 ]; then sleep 5; else sleep 30; fi
	done
) >/dev/null 2>&1 &

exit 0

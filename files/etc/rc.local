#!/bin/sh
#
# 一次性做全版：看门狗 + 面板灯 + 固件自带验收，全部照原厂行为。
#
# 一、看门狗 —— 复刻原厂 /etc/init.d/done:58 `watchdog -T /dev/watchdog -s 5`
#     open 就是武装，之后每 5 秒 write 一字节就是喂狗。
#     必须长持有 fd：写完就 close 会让驱动 disarm，等于没开。
#
# 二、面板灯 —— 复刻原厂 /etc/diag.sh 与 /etc/status/*.sh 的方式（用脚本点灯，
#     不用内核 trigger）：
#       GPIO32 SYS  : diag.sh done → sealed 32 "slow"    ⇒ 慢闪
#       GPIO30 LINK : eth_led.sh   → WAN 或 LAN 任一 link up ⇒ on
#       GPIO33      : vpn.sh/ipsec.sh → sealed 33 on/off   ⇒ VPN 状态
#                     （面板丝印是 WIFI，本版同时并入无线状态，两者任一为真就亮）
#       GPIO31 4G   : 原厂脚本未引用，由二进制下发；本版按 EC20 枚举状态驱动
#
# 三、固件自带验收 —— 结果写 flash，不再依赖那个二十秒窗口：
#       t≈165s  写 /root/accept.txt（跑不到这一步就说明没修好）
#       t≈200s  追加 alive@200（越过死点，问题解决）
#     刷完后只需：cat /root/accept.txt
#

L=/sys/class/leds
SYS=$L/green:power/brightness
LNK=$L/link/brightness
WIF=$L/green:wlan/brightness
WIFT=$L/green:wlan/trigger
FF4=$L/4g/brightness

# 把内核 trigger 放开，改由脚本管（原厂也是脚本管）
for t in $L/link/trigger $WIFT; do [ -w "$t" ] && echo none > "$t" 2>/dev/null; done

# ---------- 一、喂狗 ----------
(
	exec 3>/dev/watchdog 2>/dev/null
	if [ $? -ne 0 ]; then
		echo "WDOG=OPEN_FAIL" > /tmp/wdog.log
		exit 0
	fi
	echo "WDOG=OPEN_OK up=$(cut -d' ' -f1 /proc/uptime)" > /tmp/wdog.log
	while :; do
		up=$(cut -d' ' -f1 /proc/uptime)
		if printf 'X' >&3 2>/dev/null; then
			echo "up=$up FEED_OK" >> /tmp/wdog.log
		else
			echo "up=$up FEED_FAIL" >> /tmp/wdog.log
		fi
		sleep 5
	done
) >/dev/null 2>&1 &

# ---------- 二、面板灯 ----------
# SYS 慢闪（原厂 sealed 32 "slow"）：1 秒亮 / 1 秒灭
(
	s=0
	while :; do
		s=$((1 - s))
		[ -w "$SYS" ] && echo $s > "$SYS" 2>/dev/null
		sleep 1
	done
) >/dev/null 2>&1 &

# LINK / WIFI / 4G，每 2 秒根据真实状态刷新
(
	while :; do
		up=$(cut -d' ' -f1 /proc/uptime)
		# LINK：任一以太网口 link up（复刻 eth_led.sh 的 wan+lan 逻辑）
		l=0
		for n in eth0.1 eth0.2 br-lan wan lan; do
			grep -q up /sys/class/net/$n/operstate 2>/dev/null && { l=1; break; }
		done
		# WIFI
		w=0
		[ -d /sys/class/ieee80211/phy0 ] && w=1
		pidof hostapd >/dev/null 2>&1 && w=1
		grep -q up /sys/class/net/phy0-ap0/operstate 2>/dev/null && w=1
		# 复刻原厂：GPIO33 同时兼作 VPN 指示
		{ [ -e /sys/class/net/ppp0 ] || [ -e /sys/class/net/ipsec0 ]; } && w=1
		# 4G：EC20 已枚举（QMI 节点或 usb 设备在）
		r=0
		ls /dev/cdc-wdm* >/dev/null 2>&1 && r=1
		[ -d /sys/class/net/wwan0 ] && r=1
		grep -q 2c7c /sys/kernel/debug/usb/devices 2>/dev/null && r=1
		[ -w "$LNK" ] && echo $l > "$LNK" 2>/dev/null
		[ -w "$WIF" ] && echo $w > "$WIF" 2>/dev/null
		[ -w "$FF4" ] && echo $r > "$FF4" 2>/dev/null
		echo "up=$up link=$l wifi=$w 4g=$r" >> /tmp/led.log
		sleep 2
	done
) >/dev/null 2>&1 &

# ---------- 三、固件自带验收（写 flash，只写两次）---------
AC=/root/accept.txt
(
	while :; do
		up=$(cut -d' ' -f1 /proc/uptime)
		if [ "$up" -ge 165 ] && [ ! -f /tmp/.ck165 ]; then
			{
				echo "===== CHECKPOINT t165 ====="
				echo "uptime=$up  load=$(cat /proc/loadavg)"
				echo "cmdline=$(cat /proc/cmdline)"
				echo "devmem=$(command -v devmem >/dev/null 2>&1 && echo yes || echo no)  devmem_node=$([ -c /dev/mem ] && echo yes || echo no)"
				echo "watchdog_node=$([ -e /dev/watchdog ] && echo yes || echo no)"
				echo "wdog_tail=$(tail -n 2 /tmp/wdog.log 2>/dev/null | tr '\n' '|')"
				echo "t1l=$(devmem 0x10000120 32 2>/dev/null)  t1c=$(devmem 0x10000128 32 2>/dev/null)  rst=$(devmem 0x10000038 32 2>/dev/null)"
				echo "led: sys=$(cat $SYS 2>/dev/null) link=$(cat $LNK 2>/dev/null) wifi=$(cat $WIF 2>/dev/null) 4g=$(cat $FF4 2>/dev/null)"
				echo "ledlog=$(tail -n 2 /tmp/led.log 2>/dev/null | tr '\n' '|')"
				echo "mtd:"; cat /proc/mtd
			} > $AC 2>&1
			sync
			touch /tmp/.ck165
		fi
		if [ "$up" -ge 200 ] && [ ! -f /tmp/.ck200 ]; then
			echo "===== ALIVE@200 =====  uptime=$up" >> $AC
			echo "alive: t1l=$(devmem 0x10000120 32 2>/dev/null) t1c=$(devmem 0x10000128 32 2>/dev/null)" >> $AC
			dmesg | grep -iE 'watchdog|rt2880|rt-timer' >> $AC 2>/dev/null
			sync
			touch /tmp/.ck200
		fi
		sleep 5
	done
) >/dev/null 2>&1 &

exit 0

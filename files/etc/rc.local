#!/bin/sh
#
# 【排障期专用】开机取证脚本，定案后整份删除即可
# 1) 每次开机把 uptime 与看门狗驱动的那行日志追加到 /root/diag/boot.log
# 2) 后台每 10 秒记一次：uptime / 看门狗 state / timeleft / timeout / loadavg
#    同时把最近的 dmesg 快照到 /root/diag/last-dmesg.log（重启后仍在，等于“临终遗言”）
# 3) 日志自限长 200 行，不会把 flash 写满

D=/root/diag
mkdir -p $D
W=/sys/class/watchdog/watchdog0

{
	echo "=== boot $(date 2>/dev/null) up=$(cut -d' ' -f1 /proc/uptime)"
	dmesg 2>/dev/null | grep -iE "rt2880_wdt|Linux version|Memory:" | head -5
} >> $D/boot.log

(
	while :; do
		echo "$(date +%s) up=$(cut -d' ' -f1 /proc/uptime) state=$(cat $W/state 2>/dev/null) left=$(cat $W/timeleft 2>/dev/null) to=$(cat $W/timeout 2>/dev/null) load=$(cut -d' ' -f1-3 /proc/loadavg)" >> $D/up.log
		tail -n 200 $D/up.log > $D/up.tmp 2>/dev/null && mv $D/up.tmp $D/up.log
		dmesg 2>/dev/null | tail -n 200 > $D/last-dmesg.log
		sleep 10
	done
) >/dev/null 2>&1 &

exit 0

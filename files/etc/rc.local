#!/bin/sh
#
# 照抄原厂行为：武装硬件看门狗，并每 5 秒喂一次。
#   原厂 /etc/init.d/done:58 → `watchdog -T /dev/watchdog -s 5`
#   我们之前把驱动禁掉、也没人 open /dev/watchdog，等于“狗饿着”，到点就吸人。
#
# 关键：必须长期持有 /dev/watchdog 的 fd。
#   如果每次 `echo X > /dev/watchdog` 后就关闭，驱动会在 close 时 disarm，
#   变成“开了又关”，跟没开一样。所以用 exec 3> 把 fd 一直拿着。
#
# 验证：
#   cat /tmp/wdog.log     能看到每秒 5 秒一条 feed 记录
#   ls -l /dev/watchdog    应存在
#   uptime 能跑过 200 秒    就说明不会再自动重启
#

(
	exec 3>/dev/watchdog 2>/dev/null
	if [ $? -ne 0 ]; then
		echo "FAIL: 无法打开 /dev/watchdog（驱动未加载或节点不存在）" > /tmp/wdog.log
		exit 0
	fi
	echo "open /dev/watchdog OK at up=$(cut -d' ' -f1 /proc/uptime)" > /tmp/wdog.log
	while :; do
		up=$(cut -d' ' -f1 /proc/uptime)
		if printf 'X' >&3 2>/dev/null; then
			echo "up=$up feed OK" >> /tmp/wdog.log
		else
			echo "up=$up feed FAIL" >> /tmp/wdog.log
		fi
		sleep 5
	done
) >/dev/null 2>&1 &

exit 0

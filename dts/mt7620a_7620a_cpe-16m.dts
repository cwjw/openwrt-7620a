// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
// 板级描述：Sealan SL-IR4 / TX20（MT7620A + 16MB SPI-NOR + 128MB DDR2）
// 1 LAN + 1 WAN，仅 2.4G，4 颗指示灯（link / wifi / sys / 4g），SIM 卡槽，1 个 reset 键
//
// 全部参数来自原厂 16MB 整片备份 D:\router\tx20-boot.bin 的逆向结果：
//   分区：u-boot 0x00000 +0x30000 / u-boot-env 0x30000 +0x10000 / factory 0x40000 +0x10000
//         firmware 0x50000 +0xAC0000（原厂 squashfs 数据止于 0xB0E004）
//         rootfs_data 0xB10000 +0x4F0000（原厂 jffs2 所在的尾巴，交给 OpenWrt 当 overlay）
//   内核 cmdline：console=ttyS1,57600n8 root=/dev/mtdblock5
//   网口：lan_port=0、wan_port=4（/etc/status/eth_led.sh）→ mediatek,portmap = "llllw"
//   指示灯：link=GPIO30(netdev) sys=GPIO32 /etc/init.d/led status_led、wifi=GPIO31、4G=GPIO33
//   按键：btnd reset 35 → GPIO35
//   内存：W9751G6KB-25 单颗 128MB DDR2（W9751G6KB = 1Gb）
//
// 注意：rootfs_data 必须显式声明。原厂在 0xB10000 放了 SeaOS 的 jffs2，
//       不声明的话 fstools 会自己去扩大 rootfs 并把这玩意当 overlay 挂上，
//       导致 /etc/config 全是原厂那套（uhttpd 去找 /usr/bin/php-fcgi）。
//       声明后能按名字擦除，并由 7620a-overlay-guard 在首启时自动清掉。

/dts-v1/;

#include "mt7620a.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "generic,7620a-cpe-16m", "ralink,mt7620a-soc";
	model = "Sealan SL-IR4 (TX20) 4G CPE";

	aliases {
		led-boot = &led_sys;
		led-failsafe = &led_sys;
		led-running = &led_sys;
		led-upgrade = &led_sys;
	};

	chosen {
		bootargs = "console=ttyS1,57600n8";
	};

	/* MT7620A DDR2 基址 0x0，W9751G6KB-25 为 1Gb=128MB */
	memory@0 {
		device_type = "memory";
		reg = <0x0 0x8000000>;
	};

	leds {
		compatible = "gpio-leds";

		/* GPIO32：原厂 /etc/init.d/led 的 status_led = 32 */
		led_sys: led-sys {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio1 8 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		/* GPIO30：原厂 eth_led.sh 的 wan_lan_led_num = 30（link 灯） */
		led-link {
			label = "link";
			gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "netdev";
		};

		/* GPIO31：四灯中剩余的一颗，即 wifi 灯 */
		led-wifi {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy0tpt";
		};

		/* GPIO33：原厂 ipsec/vpn 脚本用 "sealed 33 on/off" 点灯，即 4G/上网状态灯 */
		led-4g {
			label = "4g";
			gpios = <&gpio1 9 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys";

		/* GPIO35：原厂 btnd reset 35 */
		reset {
			label = "reset";
			gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};
};

&gpio1 {
	status = "okay";
};

/* 板载 RS232（ADM3202）接在 UART0 上，原厂内核即 console=ttyS1,57600n8 */
&uart {
	status = "okay";
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x30000 0x10000>;
				read-only;
			};

			partition@40000 {
				label = "factory";
				reg = <0x40000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x200>;
					};

					macaddr_factory_4: macaddr@4 {
						reg = <0x4 0x6>;
					};
				};
			};

			partition@50000 {
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x50000 0xac0000>;
			};

			/* 原厂 jffs2 所在区：显式声明成 rootfs_data，供 overlay 使用 */
			partition@b10000 {
				label = "rootfs_data";
				reg = <0xb10000 0x4f0000>;
			};
		};
	};
};

&ethernet {
	nvmem-cells = <&macaddr_factory_4>;
	nvmem-cell-names = "mac-address";
	/* 原厂：port0 = LAN，port4 = WAN */
	mediatek,portmap = "llllw";
};

&wmac {
	nvmem-cells = <&eeprom_factory_0>;
	nvmem-cell-names = "eeprom";
};

/*
 * 只把确实被当作 GPIO 用的引脚组放开：
 * LED(30-33) 落在 rgmii1 复用区，reset(35) 与 link 灯同组；
 * i2c / wled 在本板上没有对应器件。
 * 不放开 uartf —— 串口控制台要留在 UART0 上。
 */
&state_default {
	gpio {
		groups = "i2c", "wled", "rgmii1", "rgmii2";
		function = "gpio";
	};
};

&pcie {
	status = "okay";
};

&ehci {
	status = "okay";
};

&ohci {
	status = "okay";
};

/*
 * 关闭 SoC 硬件看门狗（rt2880_wdt）：
 * 本板上 procd 打开 /dev/watchdog 后无法稳定喂狗，运行 1~2 分钟即被硬复位；
 * 解绑驱动后现场仍复位，说明计数器一旦启用就停不下来。
 * 关掉后内核不再注册 /dev/watchdog，procd 的软件看门狗（procd - watchdog -）照常工作。
 */
&watchdog {
	status = "disabled";
};

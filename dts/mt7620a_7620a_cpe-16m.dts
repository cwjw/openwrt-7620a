// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
// 板级描述：Sealan SL-IR4 / TX20（MT7620A + 16MB SPI-NOR，DDR2）
// 1 LAN + 1 WAN，仅 2.4G，4 颗指示灯（上排 WIFI/4G，下排 SYS/LINK），SIM 卡槽，1 个 reset 键
//
// 【重要：内存刻意不声明 memory 节点】
// 撤掉 memory@0 = <0x0 0x8000000>（128MB）的原因：
//   原厂 SeaOS 自己报 MemTotal 64MB，说明 U-Boot 的 DDR 初始化只配了 64MB；
//   内核按 DTB 拿 128MB 去用会采到未初始化的高部地址，实测一刷就起不来。
//   不写 memory 节点时沿用目标默认 64MB（之前稳定启动的那版就是这个配置）。
//   将来实测确认 DDR 真是 128MB 且 U-Boot 已初始化，再把节点加回来。
//
// 【rootfs_data 也不再手动声明】
// 之前的版本声明了 partition@b10000（0xB10000 +0x4F0000），与内核 squashfs-split
// 自动生成的同名分区存在冲突风险（双 rootfs_data）。现在交给 mtdsplit 自切，
// 这是已经验证能正常启动的配置。原厂 jffs2 仍留在 0xB10000，由 82_7620a_overlay_guard 清理/忽略。
//
// 实测确认的板级参数（来自原厂 16MB 备份 D:\router\tx20-boot.bin + 设备实测
//   以及原厂 squashfs rootfs 反解后的脚本）：
//   分区：u-boot 0x00000 +0x30000 / u-boot-env 0x30000 +0x10000 / factory 0x40000 +0x10000
//         firmware 0x50000 +0xAC0000（原厂 squashfs 数据止于 0xB0E004）
//   内核 cmdline：console=ttyS1,57600n8 root=/dev/mtdblock5
//   网口：lan_port=0、wan_port=4（/etc/status/eth_led.sh）→ mediatek,portmap = "llllw"
//   灯（全部来自原厂 rootfs 里 sealed <gpio> <state> 的调用）：
//     GPIO30 = LINK   （/etc/status/eth_led.sh: wan_lan_led_num=30）
//     GPIO32 = SYS    （/etc/diag.sh: status_led=32）
//     GPIO31 = 4G     （实测点亮 4G 灯；原厂脚本未引用此脚，故原为“未知”，本轮按实测纠正）
//     GPIO33 = WIFI   （原厂 /etc/status/ipsec.sh、vpn.sh 里 sealed 33 on/off，是本板上确实)
//                     (存在的第 4 颗灯脚；WIFI 归属待现场再确认一次)
//   按键：btnd reset 35 → GPIO35

/dts-v1/;

#include "mt7620a.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "generic,7620a-cpe-16m", "ralink,mt7620a-soc";
	model = "Sealan SL-IR4 (TX20) 4G CPE";

	aliases {
		led-boot = &led_sys;
		led-failsafe = &led_sys;
		led-running = &led_sys;
		led-upgrade = &led_sys;
	};

	chosen {
		bootargs = "console=ttyS1,57600n8";
	};

	leds {
		compatible = "gpio-leds";

		/* GPIO32：原厂 /etc/diag.sh 的 status_led = 32，实测 = 面板 SYS */
		led_sys: led-sys {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio1 8 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		/* GPIO30：原厂 eth_led.sh 的 wan_lan_led_num = 30，实测 = 面板 LINK */
		led-link {
			label = "link";
			gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "netdev";
		};

		/* GPIO31：实测点亮 4G 灯。上一版误把它当成 WIFI，本轮纠正 */
		led-4g {
			label = "4g";
			gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		/* GPIO33：原厂 ipsec.sh / vpn.sh 用 sealed 33 控制，是本板第 4 颗灯
		 * 若现场发现 WIFI 灯不亮，用 /sys/class/gpio 扫 33/29/34/36 再定案 */
		led-wifi {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio1 9 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy0tpt";
		};
	};

	keys {
		compatible = "gpio-keys";

		/* GPIO35：原厂 btnd reset 35 */
		reset {
			label = "reset";
			gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};
};

&gpio1 {
	status = "okay";
};

/* 板载 RS232（ADM3202）接在 UART0 上，原厂内核即 console=ttyS1,57600n8 */
&uart {
	status = "okay";
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x30000 0x10000>;
				read-only;
			};

			partition@40000 {
				label = "factory";
				reg = <0x40000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x200>;
					};

					macaddr_factory_4: macaddr@4 {
						reg = <0x4 0x6>;
					};
				};
			};

			partition@50000 {
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x50000 0xac0000>;
			};
		};
	};
};

&ethernet {
	nvmem-cells = <&macaddr_factory_4>;
	nvmem-cell-names = "mac-address";
	/* 原厂：port0 = LAN，port4 = WAN */
	mediatek,portmap = "llllw";
};

&wmac {
	nvmem-cells = <&eeprom_factory_0>;
	nvmem-cell-names = "eeprom";
};

/*
 * 只把确实被当作 GPIO 用的引脚组放开：
 * LED(30-33) 落在 rgmii1 / wled 复用区，reset(35) 与 link 灯同组；
 * i2c 在本板上没有对应器件。
 * 不放开 uartf —— 串口控制台要留在 UART0 上。
 */
&state_default {
	gpio {
		groups = "i2c", "wled", "rgmii1", "rgmii2";
		function = "gpio";
	};
};

&pcie {
	status = "okay";
};

&ehci {
	status = "okay";
};

&ohci {
	status = "okay";
};

/*
 * 方案C：SoC 硬件看门狗（rt2880_wdt）彻底不武装 —— 一次性判定复位来源。
 *
 * 原理：本节点 disabled → 内核根本不注册 /dev/watchdog → procd 的
 *   watchdog_init() 拿不到设备（原来它在 13 秒成功 open 并 ioctl SETTIMEOUT=30、
 *   之后每 5 秒 write "X" 喂狗），因此硬件计数器 TMR1 从头到尾不会有任何倒计时，
 *   硬件层面不存在任何可能触发复位的看门狗。
 *
 * 补充证据（反解原厂镜像后得出）：原厂是武装看门狗的 —— /etc/init.d/done 里
 *   `watchdog -T /dev/watchdog -s 5`（/usr/bin/watchdog，MTK APSoC WatchDog Daemon），
 *   但它从不 ioctl 设超时，只用驱动默认值，每 5 秒 write 一字节喂狗。
 *   另：原厂 U-Boot 里找不到 TMR1LOAD/TMR1CTL 常量，可排除 bootloader 武装看门狗。
 *
 * 判读：
 *   ① 本镜像不再自动重启 → 根因即为看门狗（实测死点在 158/165/166/172.61 秒），
 *      终局方案应改成“像原厂那样武装 + 让 write 喂狗真正生效”，而不是永久关闭。
 *   ② 本镜像仍在 ~170 秒重启 → 看门狗彻底出局，转查硬件级复位（电源/复位线）。
 *
 * 注：方案B（patches/rt2880-wdt-fix-ping.patch）仍保留在源码树里，本镜像不执行。
 */
&watchdog {
	status = "disabled";
};

// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
// 板级描述：Sealan SL-IR4 / TX20（MT7620A + 16MB SPI-NOR，DDR2）
// 1 LAN + 1 WAN，仅 2.4G，4 颗指示灯（上排 WIFI/4G，下排 SYS/LINK），SIM 卡槽，1 个 reset 键
//
// 【内存刻意不声明 memory 节点】
// 不声明 memory 时沿用目标默认 64MB（已验证能稳定启动）。
//
// 【rootfs_data 由 mtdsplit 自切】
// 原厂 jffs2 仍留在 0xB10000。
//
// 实测确认的板级参数：
//   分区：u-boot 0x00000 +0x30000 / u-boot-env 0x30000 +0x10000 / factory 0x40000 +0x10000
//         firmware 0x50000 +0xAC0000
//   内核 cmdline：console=ttyS1,57600n8
//   网口：lan_port=0、wan_port=4 → mediatek,portmap = "llllw"
//   灯：GPIO30=LINK  GPIO31=4G  GPIO32=SYS  GPIO33=WIFI
//   按键：reset GPIO35

/dts-v1/;

#include "mt7620a.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "generic,7620a-cpe-16m", "ralink,mt7620a-soc";
	model = "Sealan SL-IR4 (TX20) 4G CPE";

	aliases {
		led-boot = &led_sys;
		led-failsafe = &led_sys;
		led-running = &led_sys;
		led-upgrade = &led_sys;
	};

	chosen {
		bootargs = "console=ttyS1,57600n8";
	};

	/*
	 * ramoops：死前日志寄存在 DDR 里，热复位不会丢。
	 * 64MB DDR 的顶部 256KB（0x3F00000~0x3F3FFFF）预留给我自己用。
	 * 复位后把 /sys/fs/pstore/ 挂起来读，就能看到崩溃/看门狗触发前的内核输出。
	 */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		ramoops@3f00000 {
			compatible = "ramoops";
			reg = <0x3f00000 0x40000>;
			record-size = <0x10000>;
			console-size = <0x20000>;
			pmsg-size = <0x10000>;
		};
	};

	leds {
		compatible = "gpio-leds";

		/* GPIO32：原厂 /etc/diag.sh status_led = 32 → 面板 SYS */
		led_sys: led-sys {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio1 8 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		/* GPIO30：原厂 eth_led.sh wan_lan_led_num = 30 → 面板 LINK */
		led-link {
			label = "link";
			gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "netdev";
		};

		/* GPIO31：实测点亮 4G 灯 */
		led-4g {
			label = "4g";
			gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		/* GPIO33：原厂 ipsec.sh / vpn.sh 用 sealed 33 控制 → 面板 WIFI */
		led-wifi {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio1 9 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy0tpt";
		};
	};

	keys {
		compatible = "gpio-keys";

		/* GPIO35：原厂 btnd reset 35 */
		reset {
			label = "reset";
			gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};
};

&gpio1 {
	status = "okay";
};

/* 板载 RS232（ADM3202）；原厂内核即 console=ttyS1,57600n8 */
&uart {
	status = "okay";
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x30000 0x10000>;
				read-only;
			};

			partition@40000 {
				label = "factory";
				reg = <0x40000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x200>;
					};

					macaddr_factory_4: macaddr@4 {
						reg = <0x4 0x6>;
					};
				};
			};

			partition@50000 {
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x50000 0xac0000>;
			};
		};
	};
};

&ethernet {
	nvmem-cells = <&macaddr_factory_4>;
	nvmem-cell-names = "mac-address";
	/* 原厂：port0 = LAN，port4 = WAN */
	mediatek,portmap = "llllw";
};

&wmac {
	nvmem-cells = <&eeprom_factory_0>;
	nvmem-cell-names = "eeprom";
};

/*
 * 只把确实被当作 GPIO 用的引脚组放开：
 * LED(30-33) 落在 rgmii1 / wled 复用区，reset(35) 与 link 灯同组；
 * 不放开 uartf —— 串口控制台要留在 UART0 上。
 */
&state_default {
	gpio {
		groups = "i2c", "wled", "rgmii1", "rgmii2";
		function = "gpio";
	};
};

&pcie {
	status = "okay";
};

&ehci {
	status = "okay";
};

&ohci {
	status = "okay";
};

/*
 * 硬件看门狗：保持 okay，由 procd 句柄持有。
 *
 * 实测结论（2026-11-21）：
 *   /dev/watchdog 被 procd(pid 1) 持有，用户态再 open 返回 EBUSY；
 *   /sys/class/watchdog/watchdog0 = timeout 30 / max 107 / state active；
 *   若“喂狗无效”则应在 77 秒复位，但实测死点仍是 ~174.5 秒，
 *   且 SYSC_RSTSTAT=c0030000 的 WDT_RST_CAUSE(bit1) 未置位。
 *   → 复位不来自 TMR1 看门狗。
 *
 * 174.4 秒 ≈ 0x1A000 × 65536 / 40MHz，像一个独立计数器数到封顶。
 * 本版保留 okay，并把 TMR 块寄存器序列每 5 秒写进 flash，用来抓那个计数器。
 */
&watchdog {
	status = "okay";
};

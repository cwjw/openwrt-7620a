From: cwjw <noreply@github.com>
Subject: [PATCH] watchdog: rt2880_wdt: 喂狗时同时脉冲 TMRSTAT.TMR1RST

只写 TMR1LOAD 未必真正重装硬件计数器（TMR1RST 位在驱动里定义了却从未使用），
再补一拍 TMRSTAT.TMR1RST，并重写一次 ENABLE 位，三条路径任一有效即可喂住。
顺便在 probe 打印 TMR1CTL / TMRSTAT / SYSC_RSTSTAT，便于判读复位来源。

---
--- a/drivers/watchdog/rt2880_wdt.c
+++ b/drivers/watchdog/rt2880_wdt.c
@@ -16,6 +16,7 @@
 #include <linux/moduleparam.h>
 #include <linux/platform_device.h>
 #include <linux/mod_devicetable.h>
+#include <linux/io.h>
 
 #include <asm/mach-ralink/ralink_regs.h>
 
@@ -28,7 +29,11 @@
 #define TIMER_REG_TMR1LOAD		0x00
 #define TIMER_REG_TMR1CTL		0x08
 
+#define TIMER_REG_TMRSTAT		0x00
 #define TMRSTAT_TMR1RST			BIT(5)
+/* TMRSTAT 是 timer 块的首寄存器(0x100)，本驱动窗口从 0x120 起，相差 0x20；
+ * palmbus 按页映射，0x100 与 0x120 同页，可用负偏移直接访问。 */
+#define TIMER_TMRSTAT_GAP		0x20
 
 #define TMR1CTL_ENABLE			BIT(7)
 #define TMR1CTL_MODE_SHIFT		4
@@ -64,11 +69,33 @@
 	return ioread32(base + reg);
 }
 
+/* TMRSTAT(0x100) 落在 watchdog 节点(0x120)窗口之外，用同页负偏移访问 */
+static inline void rt_wdt_stat_w32(struct rt2880_wdt_data *drvdata, u32 val)
+{
+	iowrite32(val, drvdata->base - TIMER_TMRSTAT_GAP);
+}
+
+static inline u32 rt_wdt_stat_r32(struct rt2880_wdt_data *drvdata)
+{
+	return ioread32(drvdata->base - TIMER_TMRSTAT_GAP);
+}
+
 static int rt288x_wdt_ping(struct watchdog_device *w)
 {
 	struct rt2880_wdt_data *drvdata = watchdog_get_drvdata(w);
+	u32 t;
 
 	rt_wdt_w32(drvdata->base, TIMER_REG_TMR1LOAD, w->timeout * drvdata->freq);
+	/*
+	 * 只写 TMR1LOAD 未必会真正重装计数器（本文件早就定义了 TMR1RST 位却
+	 * 从未使用），因此额外向 TMRSTAT 打 TMR1RST；最后再把 ENABLE 位重写
+	 * 一遍，覆盖“写使能即启动”的实现差异。三条路径任一有效即可喂住。
+	 */
+	rt_wdt_stat_w32(drvdata, TMRSTAT_TMR1RST);
+
+	t = rt_wdt_r32(drvdata->base, TIMER_REG_TMR1CTL);
+	t |= TMR1CTL_ENABLE;
+	rt_wdt_w32(drvdata->base, TIMER_REG_TMR1CTL, t);
 
 	return 0;
 }
@@ -162,6 +189,12 @@
 
 	drvdata->freq = clk_get_rate(drvdata->clk) / RALINK_WDT_PRESCALE;
 
+	/* 取证：开机时计数器是否已被 bootloader 武装、上次复位是否看门狗所致 */
+	dev_info(dev, "TMR1CTL=%08x(en=%d) TMRSTAT=%08x SYSC_RSTSTAT=%08x\n",
+		 rt_wdt_r32(drvdata->base, TIMER_REG_TMR1CTL),
+		 !!(rt_wdt_r32(drvdata->base, TIMER_REG_TMR1CTL) & TMR1CTL_ENABLE),
+		 rt_wdt_stat_r32(drvdata), rt_sysc_r32(SYSC_RSTSTAT));
+
 	wdt = &drvdata->wdt;
 	wdt->info = &rt288x_wdt_info;
 	wdt->ops = &rt288x_wdt_ops;

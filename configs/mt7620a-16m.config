# MT7620A / 16MB SPI-NOR (MX25L12835F) / 128MB DDR2 / 仅 2.4G / 1WAN+1LAN / SIM 卡槽
# 自定义板型：7620a_cpe-16m（DTS 由 dts/ 目录注入，镜像定义由 diy-part1.sh 追加）
# 种子配置，只写关键项；其余由 make defconfig 自动补全。

# ---------- 目标平台 ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y

# ---------- 板型 ----------
# 主固件：本机定制板型
CONFIG_TARGET_ramips_mt7620_DEVICE_7620a_cpe-16m=y
# 兜底固件：最简 7620A 参考板（板级 DTS 有问题时用来验证内核/串口是否正常）
CONFIG_TARGET_ramips_mt7620_DEVICE_ralink_mt7620a-evb=y

# ---------- 镜像 ----------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=104
CONFIG_TARGET_KERNEL_PARTSIZE=4
CONFIG_TARGET_IMAGES_GZIP=y

# ---------- LuCI 语言与主题 ----------
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ---------- 4G / 蜂窝网络 ----------
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_usb-modeswitch-data=y

# ---------- 常用网络功能 ----------
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y

# ---------- IPv6 ----------
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y

# ---------- 运维小工具 ----------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_dropbear=y

# ---------- 其它 ----------
CONFIG_STRIP_KERNEL_EXPORTS=y
CONFIG_USE_MKLIBS=y
